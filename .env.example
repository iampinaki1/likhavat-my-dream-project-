# Backend Environment Variables

# Database Configuration
MONGO_URI=mongodb://localhost:27017/likhavat
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email Configuration
Email_USERS=your_email@gmail.com
Email_PASS=your_app_password

# Cloudinary Configuration
CLOUD_NAME=your_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# JWT Secrets (use strong random strings)
JWT_SECRET_ACCESS=your_jwt_access_secret
JWT_SECRET_REFRESH=your_jwt_refresh_secret

# For production, use:
# NODE_ENV=production
# FRONTEND_URL=https://yourdomain.com
# MONGO_URI=mongodb+srv://...
